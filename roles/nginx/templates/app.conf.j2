# Managed by Ansible - do not edit by hand
server {
    listen {{ nginx_http_port }} default_server;
    server_name {{ nginx_server_name }};

    root {{ app_root }};
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
